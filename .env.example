# SyteLine MCP Server Configuration
# 
# REQUIRED: SyteLine Server Configuration
# Replace these values with your actual SyteLine server details
BASE_URL=http://your-syteline-server:port/IDORequestService/ido

# REQUIRED: SyteLine Authentication Credentials
# These are passed as HTTP headers to /token/{config}
SYTELINE_USERNAME=your_username
SYTELINE_PASSWORD=your_password
SYTELINE_CONFIG=SL_PROD

# OPTIONAL: Additional Configuration
# API_KEY=your_api_key_if_required

# Environment Configuration
NODE_ENV=production

# Example for a typical SyteLine IDORequestService setup:
# BASE_URL=https://your-syteline-server.company.com:8080/IDORequestService/ido
# SYTELINE_USERNAME=your_username
# SYTELINE_PASSWORD=your_password
# SYTELINE_CONFIG=SL_PROD