	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"requests": {},
				"exec": [
					"// Auto-authentication script",
					"// This script will automatically get a token if one doesn't exist",
					"",
					"const authToken = pm.collectionVariables.get('token');",
					"",
					"if (!authToken || authToken === '') {",
					"    console.log('No auth token found, attempting to get one...');",
					"    ",
					"    const baseUrl = pm.collectionVariables.get('baseUrl');",
					"    const config = pm.collectionVariables.get('config');",
					"    const username = pm.collectionVariables.get('username');",
					"    const password = pm.collectionVariables.get('password');",
					"    ",
					"    if (config && username && password) {",
					"        const tokenRequest = {",
					"            url: `${baseUrl}/token/${config}/${username}/${password}`,",
					"            method: 'GET'",
					"        };",
					"        ",
					"        pm.sendRequest(tokenRequest, function(err, response) {",
					"            if (err) {",
					"                console.log('Error getting token:', err);",
					"            } else {",
					"                const responseJson = response.json();",
					"                if (responseJson.Success && responseJson.Token) {",
					"                    pm.collectionVariables.set('token', responseJson.Token);",
					"                    console.log('Token obtained successfully');",
					"                } else {",
					"                    console.log('Failed to get token:', responseJson.Message);",
					"                }",
					"            }",
					"        });",
					"    } else {",
					"        console.log('Please set config, username, and password variables');",
					"    }",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"requests": {},
				"exec": [
					"// Auto-save token from SecurityToken responses",
					"if (pm.info.requestName.includes('Security Token')) {",
					"    const responseJson = pm.response.json();",
					"    if (responseJson.Success && responseJson.Token) {",
					"        pm.collectionVariables.set('token', responseJson.Token);",
					"        console.log('Token saved to collection variables');",
					"    }",
					"}",
					"",
					"// Basic response validation",
					"pm.test('Response has Success field', function () {",
					"    const responseJson = pm.response.json();",
					"    pm.expect(responseJson).to.have.property('Success');",
					"});",
					"",
					"pm.test('Status code is 200', function () {",
					"    pm.response.to.have.status(200);",
					"});"
				]
			}
		}
	],
